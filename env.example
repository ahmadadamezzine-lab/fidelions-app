# Copie ces variables dans Vercel (Project Settings > Environment Variables).
# Ne mets JAMAIS de vraies valeurs dans ce fichier ni dans Git.

# L'email du compte de service Google Cloud (se termine par
# ...gserviceaccount.com), trouvé dans le fichier JSON téléchargé.
GOOGLE_WALLET_CLIENT_EMAIL=

# La clé privée du même fichier JSON (champ "private_key").
GOOGLE_WALLET_PRIVATE_KEY=

# L'ID de la classe de fidélité créée dans la Google Wallet Business Console.
GOOGLE_WALLET_CLASS_ID=3388000000023199659.fidelions_loyalty

# Base de données (ajout/mise à jour des tampons, parrainage).
# Créée automatiquement en connectant Upstash Redis à ton projet Vercel
# (Storage > Create Database > Upstash Redis) : Vercel ajoute ces
# variables tout seul, tu n'as rien à copier ici.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Mot de passe pour accéder à /commercant (l'espace où le restaurant
# ajoute les tampons). Choisis-en un toi-même.
MERCHANT_PASSWORD=

# Optionnel : lien "Laisser un avis Google" affiché sur la carte Wallet.
# Format : https://search.google.com/local/writereview?placeid=XXXXXXX
# (placeid trouvable via https://developers.google.com/maps/documentation/places/web-service/place-id)
# Laisse vide pour ne pas afficher ce bouton pour l'instant.
GOOGLE_REVIEW_URL=
