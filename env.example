# Copie ces variables dans Vercel (Project Settings > Environment Variables).
# Ne mets JAMAIS de vraies valeurs dans ce fichier ni dans Git.

# L'email du compte de service Google Cloud (se termine par
# ...gserviceaccount.com), trouvé dans le fichier JSON téléchargé. Ce même
# compte signe désormais les classes de fidélité de TOUS les restaurants
# inscrits sur Fidélions (comme un compte Stripe qui sert plusieurs
# marchands) — inchangé depuis la version mono-restaurant.
GOOGLE_WALLET_CLIENT_EMAIL=

# La clé privée du même fichier JSON (champ "private_key").
GOOGLE_WALLET_PRIVATE_KEY=

# L'identifiant "issuer" Google Wallet — la partie AVANT le premier point
# de ton ancien GOOGLE_WALLET_CLASS_ID (ex : si c'était
# "3388000000023199659.fidelions_loyalty", c'est "3388000000023199659").
# Sert à fabriquer automatiquement une classe de fidélité à chaque nouvelle
# inscription de restaurant.
GOOGLE_WALLET_ISSUER_ID=

# Ancien identifiant de classe unique (mono-restaurant) — n'est plus utilisé
# par l'application au quotidien (chaque restaurant a maintenant sa propre
# classe, créée automatiquement à l'inscription). Reste nécessaire une seule
# fois pour /api/migrate-demo, qui rattache tes données existantes à ta
# classe déjà créée. Tu peux la retirer après cette migration si tu veux.
GOOGLE_WALLET_CLASS_ID=3388000000023199659.fidelions_loyalty

# Base de données (comptes commerçants, clients, tampons, parrainage).
# Créée automatiquement en connectant Upstash Redis à ton projet Vercel
# (Storage > Create Database > Upstash Redis) : Vercel ajoute ces
# variables tout seul, tu n'as rien à copier ici.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Clé secrète qui signe les sessions de connexion (/commercant). Choisis
# une longue valeur aléatoire (ex : générée avec `openssl rand -hex 32`) et
# ne la partage jamais — quiconque la connaît peut se faire passer pour
# n'importe quel compte commerçant. Remplace l'ancien MERCHANT_PASSWORD
# (chaque commerçant a maintenant son propre email + mot de passe, stockés
# en base, plus une seule valeur partagée).
SESSION_SECRET=

# Optionnel : pour que les campagnes puissent aussi partir par email (en
# plus de la notification Wallet). Compte gratuit sur resend.com.
RESEND_API_KEY=

# Optionnel : adresse d'envoi des emails de campagne. Laisse vide pour
# utiliser l'adresse de test Resend par défaut (fonctionne sans configurer
# de domaine, mais affiche "via resend.dev").
RESEND_FROM_EMAIL=

# Optionnel : lien "Laisser un avis Google" affiché sur la carte Wallet.
# Format : https://search.google.com/local/writereview?placeid=XXXXXXX
# (placeid trouvable via https://developers.google.com/maps/documentation/places/web-service/place-id)
# Laisse vide pour ne pas afficher ce bouton pour l'instant.
GOOGLE_REVIEW_URL=
